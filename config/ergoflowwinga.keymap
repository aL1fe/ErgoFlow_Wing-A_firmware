#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        mc_pass07: pass07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp B &kp I &kp W &kp B &kp EXCL &kp N9 &kp N8 &kp N0 &kp M &kp B &kp I &kp W &kp B>;
            label = "PASS07";
        };

        mc_unicode_dot: unicode_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_6 &kt LEFT_ALT>;
            label = "UNICODE_DOT";
        };

        mc_pass06: mc_pass06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N6 &kp N9 &kp N4 &kp N5 &kp N6>;
            label = "MC_PASS06";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &kp N1        &kp N2    &kp N3     &kp N4  &kp N5  &kp DEL   &kp N6     &kp N7          &kp N8     &kp N9     &kp N0          &kp MINUS        &kp EQUAL
&kp TAB       &kp Q         &kp W     &kp E      &kp R   &kp T   &kp UP    &kp Y      &kp U           &kp I      &kp O      &kp P           &kp LBKT         &kp RBKT
&kp CAPSLOCK  &kp A         &kp S     &kp D      &kp F   &kp G   &kp BSPC  &kp H      &kp J           &kp K      &kp L      &kp SEMI        &kp SQT          &kp BSLH
&kp LSHFT     &kp Z         &kp X     &kp C      &kp V   &kp B   &kp DOWN  &kp N      &kp M           &kp COMMA  &kp DOT    &kp FSLH        &kp RIGHT_SHIFT  &kp BSPC
&kp LCTRL     &kp LEFT_WIN  &kp LALT  &kp SPACE  &mo 1   &mo 2   &kp LEFT  &kp RIGHT  &kp LC(LSHIFT)  &mo 1      &kp SPACE  &kp KP_NUMLOCK  &kp RCTRL        &kp RET
            >;
        };

        mo1_layer {
            bindings = <
&kp TILDE  &none  &none   &none                &none  &none  &none      &mc_pass06             &mc_pass07       &kp STAR         &kp FSLH         &none            &none  &bt BT_CLR
&none      &none  &none   &none                &none  &none  &kp PG_UP  &kp KP_EQUAL           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS        &none  &none
&none      &none  &none   &none                &none  &none  &none      &kp LEFT_PARENTHESIS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS         &none  &none
&none      &none  &none   &kp C_AL_CALCULATOR  &none  &none  &kp PG_DN  &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &mc_unicode_dot  &none  &kp BSPC
&none      &none  &trans  &none                &none  &mo 3  &kp HOME   &kp END                &kp LS(INS)      &none            &kp KP_NUMBER_0  &none            &none  &kp LS(KP_ENTER)
            >;
        };

        mo2_layer {
            bindings = <
&none           &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none              &kp F6           &kp F7          &kp F8  &kp F9  &kp F10         &kp F11    &kp F12
&none           &none   &none   &none   &none   &none   &kp C_VOLUME_UP    &none            &none           &none   &none   &kp UNDERSCORE  &none      &none
&kp KP_NUMLOCK  &none   &none   &none   &none   &none   &none              &kp LEFT_BRACE   &none           &none   &none   &none           &kp GRAVE  &none
&none           &none   &none   &none   &none   &none   &kp C_VOLUME_DOWN  &kp RIGHT_BRACE  &none           &none   &none   &none           &none      &kp PAUSE_BREAK
&none           &none   &none   &none   &none   &none   &none              &none            &kp LC(INSERT)  &none   &none   &none           &none      &kp LC(KP_ENTER)
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none              &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none         &none  &none              &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none         &none  &kp LEFT_BRACKET   &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none         &none  &kp RIGHT_BRACKET  &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none         &none  &none              &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
